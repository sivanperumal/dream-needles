# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public site URL (no trailing slash). http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay → Account & Settings → API Keys (use test keys in development)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → the secret you set when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# Google Apps Script web app (Contact Us → Google Sheet)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# Order emails (confirmation / shipped / delivered / cancelled), sent over SMTP.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your full Gmail
# address, SMTP_PASS=a 16-letter Google App Password (not your normal password),
# EMAIL_FROM="Dream Needles <the same Gmail address>". See SETUP.md Part 2.5.
# To switch to Resend later: SMTP_HOST=smtp.resend.com, SMTP_PORT=465,
# SMTP_USER=resend, SMTP_PASS=your re_... API key, EMAIL_FROM at your verified domain.
# Leave these empty to skip order emails (orders still work).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Development only: Figma personal access token (read-only) used to pull design specs.
# Figma → Settings → Security → Personal access tokens. Not needed in production.
FIGMA_TOKEN=
