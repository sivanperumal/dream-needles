# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public site URL (no trailing slash). http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay → Account & Settings → API Keys (use test keys in development)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → the secret you set when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# Google Apps Script web app (Contact Us → Google Sheet)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# Resend (resend.com → API Keys): order confirmation / shipped / delivered emails.
# EMAIL_FROM must use a domain you verified in Resend, e.g. "Dream Needles <orders@yourdomain.in>".
# While testing without a domain use "Dream Needles <onboarding@resend.dev>"
# (Resend then only delivers to your own Resend account email).
RESEND_API_KEY=
EMAIL_FROM=

# Development only: Figma personal access token (read-only) used to pull design specs.
# Figma → Settings → Security → Personal access tokens. Not needed in production.
FIGMA_TOKEN=
